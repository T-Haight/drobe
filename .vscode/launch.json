    "version": "0.2.0",
    "configurations": [
        {
            "name": "drobe",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "drobe (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "drobe (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "python": "C:\\Users\\Tom\\anaconda3\\envs\\dro\\python.exe",
            "module": "uvicorn",
            "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "env": {
                "DATABASE_URL": "postgresql://drobe:drobe@localhost:5432/drobe",
                "CORS_ORIGINS": "*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (Flutter + FastAPI)",
            "configurations": ["drobe", "FastAPI Backend"]
        }
    ]
}
